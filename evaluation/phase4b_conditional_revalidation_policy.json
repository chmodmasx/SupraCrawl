{
  "schema_version": 1,
  "phase": "4B",
  "gate": "phase4b-leaf-conditional-revalidation-v1",
  "base_certified_sha": "bf3db918b123c93301ad92ec047717c7af6c7e01",
  "scope": "independently opt-in conditional HTTP revalidation for crawl leaves while preserving Phase 4A BFS behavior by default",
  "request_contract": {
    "field": "conditional_revalidate_leaves",
    "default": false,
    "requires_refresh_after_s_gt_zero": true,
    "activation_condition": "conditional_revalidate_leaves and refresh_after_s > 0 and depth >= max_depth"
  },
  "validator_contract": {
    "persist": ["etag", "last_modified"],
    "send_if_present": ["If-None-Match", "If-Modified-Since"],
    "redirect_behavior": "drop conditional validators after any redirect and continue with an unconditional fetch",
    "mapping_change": "additive documents-index fields only",
    "mapping_or_lookup_failure": "fall through to the normal full-fetch path"
  },
  "acceptance": {
    "default_false_preserves_phase4a_path": true,
    "non_leaf_pages_preserve_phase4a_fetch_and_bfs": true,
    "fresh_leaf_may_skip_network_fetch": true,
    "stale_leaf_with_validator_uses_conditional_get": true,
    "stale_leaf_without_validator_uses_full_fetch": true,
    "http_304_skips_extraction_and_lexical_vector_reindex": true,
    "http_304_refreshes_document_fetched_at": true,
    "http_304_touch_failure_retries_with_unconditional_full_fetch": true,
    "http_200_after_conditional_request_uses_normal_extraction_and_indexing": true,
    "redirect_during_conditional_request_never_reuses_origin_validator_on_target": true
  },
  "outcome_contract": {
    "fresh_leaf_network_skip": {
      "indexed": false,
      "freshness_skipped": true,
      "network_fetch_skipped": true,
      "revalidated_not_modified": false
    },
    "http_304": {
      "indexed": false,
      "freshness_skipped": false,
      "network_fetch_skipped": false,
      "revalidated_not_modified": true
    }
  },
  "constraints": {
    "ranking_behavior_unchanged": true,
    "reranker_behavior_unchanged": true,
    "ssrf_and_robots_policy_unchanged": true,
    "phase4a_default_behavior_unchanged": true,
    "no_scheduler": true,
    "no_non_leaf_304": true,
    "no_new_performance_threshold": true
  }
}
