FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    SUPRACRAWL_RERANKER_ENABLED=true \
    SUPRACRAWL_RERANKER_WARMUP_ON_STARTUP=true \
    HF_HOME=/home/supracrawl/.cache/huggingface

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY scripts/verify_reranker_runtime.py ./scripts/verify_reranker_runtime.py
RUN pip install --upgrade pip && pip install '.[hybrid,reranker]'

RUN useradd --create-home --uid 10001 supracrawl \
    && mkdir -p "$HF_HOME" \
    && chown -R supracrawl:supracrawl /home/supracrawl
USER supracrawl

# Build-time admission gate: cache and execute both production model paths.
# The verifier checks dense embedding plus the exact frozen cross-encoder.
RUN python scripts/verify_reranker_runtime.py

# Runtime must use the model artifacts admitted into this image, not the network.
ENV HF_HUB_OFFLINE=1

EXPOSE 8080
CMD ["uvicorn", "supracrawl.app:app", "--host", "0.0.0.0", "--port", "8080"]
